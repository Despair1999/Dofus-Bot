{
  "name": "dofus-companion",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.15"
  },
  "scripts": {
    "lint": "eslint .",
    "test:e2e": "playwright test",
    "test:ocr": "tsx tests/ocr/smoke.ts",
    "bundle:backend": "node infrastructure/scripts/bundle-backend.mjs",
    "dev": "pnpm --parallel --filter @dofus/backend --filter @dofus/desktop dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "desktop": "pnpm --filter @dofus/desktop tauri dev"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.15.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.71.2"
  }
}
