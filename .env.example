# Lokaler Schlüssel: mindestens 32 Zeichen. setup.ps1 erzeugt einen zufälligen Wert.
COMPANION_TOKEN=
PORT=4310
HOST=127.0.0.1
BACKEND_URL=http://127.0.0.1:4310
# Optional: absoluter Pfad; Standard ist .data im Repository.
# DATA_DIR=

# Optionaler Discord-Bot; keine Ankama-Zugangsdaten erforderlich.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
DISCORD_OWNER_ID=
# DISCORD_DB_PATH=

# Release-Signierung gehört in GitHub Actions Secrets, nicht in diese Datei.
# TAURI_SIGNING_PRIVATE_KEY und TAURI_SIGNING_PRIVATE_KEY_PASSWORD
# Öffentlicher Schlüssel: Repository Actions Variable TAURI_UPDATER_PUBLIC_KEY
