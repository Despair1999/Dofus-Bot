    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@dofus/core": "workspace:*",
    "@dofus/game-data": "workspace:*",
    "discord.js": "14.27.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
