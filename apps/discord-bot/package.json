{
  "name": "@dofus/discord-bot",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx --env-file=../../.env src/index.ts",
    "start": "tsx src/index.ts",
    "register": "tsx --env-file=../../.env src/register.ts",
    "typecheck": "tsc --noEmit",
